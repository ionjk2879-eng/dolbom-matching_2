# Applied by Cloudflare static assets to every page and file.
# X-Frame-Options + frame-ancestors: no other site may embed this one in a frame (clickjacking).
# Strict-Transport-Security: browsers stay on https for a year after the first visit.
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
